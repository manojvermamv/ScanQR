{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@scanqr/core": ["../packages/scanqr-core/src/index.ts"],
      "@scanqr/core/*": ["../packages/scanqr-core/src/*"]
    }
  },
  "include": ["App.tsx", "src/**/*.ts", "src/**/*.tsx", "../packages/scanqr-core/src/**/*.ts"],
  "exclude": ["node_modules", "src/**/*.test.ts", "../packages/scanqr-core/src/**/*.test.ts"]
}
